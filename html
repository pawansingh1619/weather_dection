<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div id="card">
        <div id="header">
            <div id="txt">
                <input type="text" placeholder="enter city name">

           </div>
            <div id="head">
                <img src="search.png" alt="" id="weathericon">
            </div>
        </div>
        <p id="error">invalid city name</p>
        <div id="sun">
            <img src="mist.png" alt="">
        </div>
        <div id="tem">
            <p id="temp">0C</p>
            <p id="city">City Name</p>
        </div>
        <div id="flow">
            <div id="humidity">
                <img class="size" src="humidity.png" alt="">
                <div id="hum">
                    <p id="humid">0%</p>
                    <p>Humidity</p>
                </div>
            </div>
            <div id="speed">
                <img class="size" src="wind.png" alt="">
                <div id="wind">
                    <p id="win">0k/m</p>
                    <p>Wind Speed</p>
                </div>
            </div>
        </div>
    </div>
   <script src="javascript.js"></script> 
</body>
</html>
