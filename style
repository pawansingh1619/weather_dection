*{
    margin:0;
    padding:0;
}
body{
    background-color: black;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height:100vh;
}
#card{
    height:550px;
    width:450px;
    background-color: aquamarine;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

}
#flow{
    height:60px;
    width:350px;
    display: flex;
    justify-content:space-around;
    margin-top:50px;
    
}
#humidity{
    display: flex;
    justify-content:space-evenly;
    font-size: 1.1rem;
    margin-top:3px;
}
#speed{
    display: flex;
    justify-content:space-evenly;
    font-size: 1.1rem;
    margin-top:3px;
}
.size{
    height:30px;
    width:30px;
}
#tem{
    font-size:1.5rem;
}
#header{
    height:60px;
    width:450px;
    display: flex;
    justify-content:space-evenly;
}
#txt input{
    height:40px;
    width:350px;
    padding-left:15px;
    border: none;
    border-radius:15px;
    background-color: white;
}
#head{
    height:50px;
    width:50px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: white;
    border:none;
    border-radius: 50%;
}
#head img{
    height:25px;
    width:25px;
}
#error{
    width: 350px;
    text-align: left;
    margin-bottom: 10px;
    color: crimson;
    font-size: 25px;
    display: none;
}
